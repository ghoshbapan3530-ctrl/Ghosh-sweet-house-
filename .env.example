# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Primary Live Database):
# Obtain these from your Supabase Project Settings -> API.
# VITE_SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# VITE_SUPABASE_ANON_KEY: Project publishable/anon API key
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# GOOGLE SHEETS SYNCHRONIZATION (Server-Side Integration):
# Spreadsheet ID: 1RfwlEcYJSQPTpON9-MUW-b6dsA120PzQ-srrVvmkZH8
# Spreadsheet: Ghosh Sweet House Orders
# Sheet Tab: Orders
# GOOGLE_ACCESS_TOKEN: Server-side Google OAuth 2.0 access token or Service Account token
# with scope: https://www.googleapis.com/auth/spreadsheets
GOOGLE_ACCESS_TOKEN="your_google_cloud_oauth_or_service_token"

# FIREBASE OWNER AUTHORIZATION:
# Comma-separated list of authorized email addresses permitted to access /owner/dashboard
# and perform owner-level operations on Firestore data.
VITE_OWNER_AUTHORIZED_EMAILS="ghoshbapan3530@gmail.com,admin@ghoshsweet.com,owner@ghoshsweet.com"
