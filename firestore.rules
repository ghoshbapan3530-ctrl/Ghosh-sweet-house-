rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner authorization: checks authenticated user email against owner allowlist
    // or checks custom claim / owner document or authenticated management session
    function isOwner() {
      return isAuthenticated() && (
        request.auth.token.email == 'ghoshbapan3530@gmail.com' ||
        request.auth.token.email.matches('.*@ghoshsweet\\.com') ||
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/owner_roles/$(request.auth.uid))
      );
    }

    // Customer identity check: matches customerId
    function isCustomerOwner(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    // String length boundary guard
    function isValidString(str, minLen, maxLen) {
      return str is string && str.size() >= minLen && str.size() <= maxLen;
    }

    // Valid 10-digit Indian mobile number
    function isValidPhone(phone) {
      return phone is string && phone.matches('^[0-9]{10}$');
    }

    // ===============================================================
    // ORDERS COLLECTION
    // ===============================================================
    match /orders/{orderId} {
      // 1. READ:
      // - Owner can list & read any order
      // - Authenticated customer can read their own order
      // - Unauthenticated customer can read their specific single order for live tracking
      allow get: if isOwner() ||
                    (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
                    (!isAuthenticated() && resource.data.orderId == orderId);

      allow list: if isOwner() ||
                     (isAuthenticated() && resource.data.customerId == request.auth.uid);

      // 2. CREATE:
      // Customers can place a new order. Must start with status 'PENDING'
      allow create: if request.resource.data.status == 'PENDING' &&
                       isValidString(request.resource.data.customerName, 2, 100) &&
                       isValidPhone(request.resource.data.phone) &&
                       request.resource.data.totalAmount is number &&
                       request.resource.data.totalAmount > 0 &&
                       request.resource.data.items is list &&
                       request.resource.data.items.size() > 0 &&
                       request.resource.data.items.size() <= 50;

      // 3. UPDATE:
      // Only authorized owner can update order status and management fields
      allow update: if isOwner();

      // 4. DELETE:
      // Deletions forbidden or owner-only
      allow delete: if isOwner();
    }

    // ===============================================================
    // CUSTOMERS COLLECTION
    // ===============================================================
    match /customers/{customerId} {
      allow get: if isOwner() || isCustomerOwner(customerId);
      allow list: if isOwner();
      allow create: if isAuthenticated() && (request.auth.uid == customerId || isOwner());
      allow update: if isOwner() || isCustomerOwner(customerId);
      allow delete: if isOwner();
    }

    // ===============================================================
    // OWNER SETTINGS COLLECTION
    // ===============================================================
    match /owner_settings/{settingsId} {
      // Public can read general store delivery settings (e.g. min order, delivery charge)
      allow get, list: if true;
      // Only authorized owner can modify settings
      allow write: if isOwner();
    }

    // ===============================================================
    // PRODUCTS COLLECTION (Optional cloud sync)
    // ===============================================================
    match /products/{productId} {
      allow get, list: if true;
      allow write: if isOwner();
    }

    // ===============================================================
    // OWNER ROLES & TOKENS
    // ===============================================================
    match /owner_roles/{userId} {
      allow read, write: if isOwner();
    }

    match /notification_logs/{logId} {
      allow read, write: if isOwner();
    }
  }
}
